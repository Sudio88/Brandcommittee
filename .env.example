# Optional. Copy to .env in the room folder to change how the question box runs councils.
#
# "claude" (default when Claude Code is installed): the room hands your question to Claude Code,
#          which runs /roast-room in the vault on your Claude plan.
# "api":    the room runs councils itself on ANTHROPIC_API_KEY (billed to the API account).
# "viewer": no question box; type /roast-room in Claude Code and the room plays it.
COUNCIL_RUNNER=claude

# Only for COUNCIL_RUNNER=api. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
